{
  "name": "SuperDuperSkills Desktop",
  "version": "4.0.0",
  "main": "main.js",
  "window": {
    "width": 1200,
    "height": 800,
    "title": "SuperDuperSkills v4.0.0 — Agentic CLI Hub",
    "icon": "G:\\Nueva carpeta\\Documentos\\superduperskills\\icon-512.png",
    "darkTheme": true
  },
  "tray": {
